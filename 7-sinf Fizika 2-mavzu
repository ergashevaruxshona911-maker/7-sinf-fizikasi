    <script>
        // Quiz interactive logic
        function checkAnswer(button, isCorrect, groupClass, feedbackText) {
            const buttons = document.querySelectorAll('.' + groupClass + '-btn');
            buttons.forEach(btn => {
                btn.disabled = true;
                btn.classList.add('opacity-60', 'cursor-not-allowed');
            });

            const feedbackEl = document.getElementById(groupClass + '-feedback');
            feedbackEl.classList.remove('hidden');

            if (isCorrect) {
                button.classList.remove('bg-slate-800', 'opacity-60');
                button.classList.add('bg-emerald-600', 'text-white', 'font-bold');
                feedbackEl.classList.add('bg-emerald-950/80', 'text-emerald-300', 'border', 'border-emerald-800');
                feedbackEl.innerHTML = '<i class="fa-solid fa-circle-check mr-1"></i> ' + feedbackText;
            } else {
                button.classList.remove('bg-slate-800', 'opacity-60');
                button.classList.add('bg-rose-600', 'text-white', 'font-bold');
                feedbackEl.classList.add('bg-rose-950/80', 'text-rose-300', 'border', 'border-rose-800');
                feedbackEl.innerHTML = '<i class="fa-solid fa-circle-xmark mr-1"></i> ' + feedbackText;
            }
        }

        // ==========================================
        // SIMULYATSIYA 1: Fazo Miqyosi va Zoom Canvas
        // ==========================================
        const canvasScale = document.getElementById('canvasScale');
        const ctxScale = canvasScale.getContext('2d');
        const scaleSlider = document.getElementById('scaleSlider');
        const scaleLabel = document.getElementById('scaleLabel');
        const scaleValText = document.getElementById('scaleValText');

        function resizeCanvasScale() {
            canvasScale.width = canvasScale.parentElement.clientWidth;
            canvasScale.height = canvasScale.parentElement.clientHeight;
        }
        window.addEventListener('resize', resizeCanvasScale);
        resizeCanvasScale();

        // Stars background
        const stars = Array.from({length: 150}, () => ({
            x: Math.random(),
            y: Math.random(),
            r: Math.random() * 1.5,
            alpha: Math.random()
        }));

        function drawScaleSimulation() {
            const val = parseFloat(scaleSlider.value); // 0 to 100
            const width = canvasScale.width;
            const height = canvasScale.height;
            const cx = width / 2;
            const cy = height / 2;

            ctxScale.clearRect(0, 0, width, height);

            // Draw Stars
            stars.forEach(s => {
                ctxScale.fillStyle = `rgba(255, 255, 255, ${s.alpha})`;
                ctxScale.beginPath();
                ctxScale.arc(s.x * width, s.y * height, s.r, 0, Math.PI * 2);
                ctxScale.fill();
            });

            if (val < 20) {
                // Stage 1: O'quvchi
                const t = val / 20;
                scaleLabel.innerText = "1. O'quvchi (1 metr)";
                scaleValText.innerText = (1 + t * 10).toFixed(1) + " m";

                // Draw stick figure
                ctxScale.strokeStyle = "#38bdf8";
                ctxScale.lineWidth = 4;
                const size = 50 * (1 - t * 0.5);

                // Head
                ctxScale.beginPath();
                ctxScale.arc(cx, cy - size, size * 0.4, 0, Math.PI * 2);
                ctxScale.stroke();
                // Body
                ctxScale.beginPath();
                ctxScale.moveTo(cx, cy - size * 0.6);
                ctxScale.lineTo(cx, cy + size * 0.4);
                // Arms & Legs
                ctxScale.moveTo(cx - size * 0.5, cy - size * 0.2);
                ctxScale.lineTo(cx + size * 0.5, cy - size * 0.2);
                ctxScale.moveTo(cx, cy + size * 0.4);
                ctxScale.lineTo(cx - size * 0.4, cy + size);
                ctxScale.moveTo(cx, cy + size * 0.4);
                ctxScale.lineTo(cx + size * 0.4, cy + size);
                ctxScale.stroke();

            } else if (val < 40) {
                // Stage 2: Maktab / Shahar
                const t = (val - 20) / 20;
                scaleLabel.innerText = "2. Maktab va Shahar (100m - 10km)";
                scaleValText.innerText = (100 + t * 9900).toFixed(0) + " m";

                // Draw school building
                ctxScale.fillStyle = "#1e293b";
                ctxScale.strokeStyle = "#818cf8";
                ctxScale.lineWidth = 3;
                const bWidth = 160 * (1 - t * 0.4);
                const bHeight = 100 * (1 - t * 0.4);

                ctxScale.fillRect(cx - bWidth/2, cy - bHeight/2, bWidth, bHeight);
                ctxScale.strokeRect(cx - bWidth/2, cy - bHeight/2, bWidth, bHeight);

                // Windows
                ctxScale.fillStyle = "#fef08a";
                for (let i = -bWidth/2 + 15; i < bWidth/2 - 15; i += 25) {
                    for (let j = -bHeight/2 + 15; j < bHeight/2 - 15; j += 25) {
                        ctxScale.fillRect(cx + i, cy + j, 12, 12);
                    }
                }

            } else if (val < 60) {
                // Stage 3: Yer sayyorasi
                const t = (val - 40) / 20;
                scaleLabel.innerText = "3. Yer sayyorasi (12,742 km)";
                scaleValText.innerText = (10000 + t * 12000000).toLocaleString() + " km";

                const r = 80 * (1 - t * 0.3);
                // Atmosphere glow
                const grad = ctxScale.createRadialGradient(cx, cy, r*0.8, cx, cy, r*1.3);
                grad.addColorStop(0, '#38bdf8');
                grad.addColorStop(1, 'transparent');
                ctxScale.fillStyle = grad;
                ctxScale.beginPath();
                ctxScale.arc(cx, cy, r*1.3, 0, Math.PI*2);
                ctxScale.fill();

                // Earth body
                ctxScale.fillStyle = "#0284c7";
                ctxScale.beginPath();
                ctxScale.arc(cx, cy, r, 0, Math.PI * 2);
                ctxScale.fill();

                // Continents
                ctxScale.fillStyle = "#22c55e";
                ctxScale.beginPath();
                ctxScale.arc(cx - r*0.2, cy - r*0.2, r*0.4, 0, Math.PI*2);
                ctxScale.arc(cx + r*0.3, cy + r*0.1, r*0.3, 0, Math.PI*2);
                ctxScale.fill();

            } else if (val < 80) {
                // Stage 4: Quyosh Tizimi
                const t = (val - 60) / 20;
                scaleLabel.innerText = "4. Quyosh Tizimi (150 mln km)";
                scaleValText.innerText = (1.5e8 * (t + 0.1)).toExponential(1) + " km";

                // Sun
                ctxScale.fillStyle = "#f59e0b";
                ctxScale.shadowColor = "#fbbf24";
                ctxScale.shadowBlur = 20;
                ctxScale.beginPath();
                ctxScale.arc(cx, cy, 30, 0, Math.PI * 2);
                ctxScale.fill();
                ctxScale.shadowBlur = 0;

                // Orbits & Planets
                const orbits = [60, 90, 130, 170];
                const colors = ["#94a3b8", "#eab308", "#38bdf8", "#ef4444"];
                orbits.forEach((orb, idx) => {
                    ctxScale.strokeStyle = "rgba(255,255,255,0.15)";
                    ctxScale.beginPath();
                    ctxScale.arc(cx, cy, orb, 0, Math.PI * 2);
                    ctxScale.stroke();

                    // Planet
                    const angle = Date.now() * 0.001 * (4 - idx);
                    const px = cx + Math.cos(angle) * orb;
                    const py = cy + Math.sin(angle) * orb;
                    ctxScale.fillStyle = colors[idx];
                    ctxScale.beginPath();
                    ctxScale.arc(px, py, 5 + idx, 0, Math.PI * 2);
                    ctxScale.fill();
                });

            } else {
                // Stage 5: Galaktika va Cheksiz Koinot
                const t = (val - 80) / 20;
                scaleLabel.innerText = "5. Sut Yo'li Galaktikasi va Cheksizlik";
                scaleValText.innerText = "Cheksiz Fazo (∞)";

                // Spiral Galaxy
                ctxScale.save();
                ctxScale.translate(cx, cy);
                ctxScale.rotate(Date.now() * 0.0005);

                for (let arm = 0; arm < 2; arm++) {
                    ctxScale.beginPath();
                    for (let i = 0; i < 200; i++) {
                        const angle = i * 0.05 + arm * Math.PI;
                        const dist = i * 0.7;
                        const gx = Math.cos(angle) * dist;
                        const gy = Math.sin(angle) * dist;
                        ctxScale.fillStyle = `rgba(${160 + i}, ${130 + i}, 255, ${1 - i/200})`;
                        ctxScale.fillRect(gx, gy, 2, 2);
                    }
                }
                ctxScale.restore();

                // Infinity Symbol Overlay
                ctxScale.fillStyle = "rgba(56, 189, 248, 0.8)";
                ctxScale.font = "bold 48px sans-serif";
                ctxScale.textAlign = "center";
                ctxScale.textBaseline = "middle";
                ctxScale.fillText("∞", cx, cy);
            }

            requestAnimationFrame(drawScaleSimulation);
        }

        scaleSlider.addEventListener('input', drawScaleSimulation);
        drawScaleSimulation();


        // ==========================================
        // SIMULYATSIYA 2: 3D Koordinatolar Canvas
        // ==========================================
        const canvas3D = document.getElementById('canvas3D');
        const ctx3D = canvas3D.getContext('2d');
        const sliderX = document.getElementById('sliderX');
        const sliderY = document.getElementById('sliderY');
        const sliderZ = document.getElementById('sliderZ');

        function resizeCanvas3D() {
            canvas3D.width = canvas3D.parentElement.clientWidth;
            canvas3D.height = canvas3D.parentElement.clientHeight;
        }
        window.addEventListener('resize', resizeCanvas3D);
        resizeCanvas3D();

        // Convert 3D world coords (x,y,z) to isometric 2D canvas coords
        function project3D(x, y, z, originX, originY) {
            const scale = 25;
            // Isometric projection angles
            const px = originX + (x - y) * Math.cos(Math.PI / 6) * scale;
            const py = originY - z * scale + (x + y) * Math.sin(Math.PI / 6) * scale;
            return { x: px, y: py };
        }

        function draw3DSimulation() {
            const x = parseFloat(sliderX.value);
            const y = parseFloat(sliderY.value);
            const z = parseFloat(sliderZ.value);

            document.getElementById('valX').innerText = x + ' m';
            document.getElementById('valY').innerText = y + ' m';
            document.getElementById('valZ').innerText = z + ' m';
            document.getElementById('coord3DText').innerText = `P(X: ${x}, Y: ${y}, Z: ${z})`;

            const w = canvas3D.width;
            const h = canvas3D.height;
            const originX = w * 0.35;
            const originY = h * 0.65;

            ctx3D.clearRect(0, 0, w, h);

            // Draw Grid on XY plane
            ctx3D.strokeStyle = "rgba(255, 255, 255, 0.05)";
            ctx3D.lineWidth = 1;
            for (let i = 0; i <= 8; i++) {
                let p1 = project3D(i, 0, 0, originX, originY);
                let p2 = project3D(i, 8, 0, originX, originY);
                ctx3D.beginPath(); ctx3D.moveTo(p1.x, p1.y); ctx3D.lineTo(p2.x, p2.y); ctx3D.stroke();

                let p3 = project3D(0, i, 0, originX, originY);
                let p4 = project3D(8, i, 0, originX, originY);
                ctx3D.beginPath(); ctx3D.moveTo(p3.x, p3.y); ctx3D.lineTo(p4.x, p4.y); ctx3D.stroke();
            }

            // Draw AXES
            const o = project3D(0, 0, 0, originX, originY);
            const maxVal = 8.5;

            // X Axis (Red) - Length
            const axX = project3D(maxVal, 0, 0, originX, originY);
            ctx3D.strokeStyle = "#ef4444"; ctx3D.lineWidth = 3;
            ctx3D.beginPath(); ctx3D.moveTo(o.x, o.y); ctx3D.lineTo(axX.x, axX.y); ctx3D.stroke();
            ctx3D.fillStyle = "#ef4444"; ctx3D.font = "bold 14px sans-serif";
            ctx3D.fillText("X (Uzunlik)", axX.x + 10, axX.y);

            // Y Axis (Green) - Width
            const axY = project3D(0, maxVal, 0, originX, originY);
            ctx3D.strokeStyle = "#22c55e"; ctx3D.lineWidth = 3;
            ctx3D.beginPath(); ctx3D.moveTo(o.x, o.y); ctx3D.lineTo(axY.x, axY.y); ctx3D.stroke();
            ctx3D.fillStyle = "#22c55e";
            ctx3D.fillText("Y (Kenglik)", axY.x - 60, axY.y + 15);

            // Z Axis (Blue) - Height
            const axZ = project3D(0, 0, maxVal, originX, originY);
            ctx3D.strokeStyle = "#3b82f6"; ctx3D.lineWidth = 3;
            ctx3D.beginPath(); ctx3D.moveTo(o.x, o.y); ctx3D.lineTo(axZ.x, axZ.y); ctx3D.stroke();
            ctx3D.fillStyle = "#3b82f6";
            ctx3D.fillText("Z (Balandlik)", axZ.x - 30, axZ.y - 10);

            // Origin Label
            ctx3D.fillStyle = "#cbd5e1"; ctx3D.font = "12px sans-serif";
            ctx3D.fillText("O(0,0,0)", o.x - 45, o.y + 15);

            // Projections for point P(x, y, z)
            const pXY = project3D(x, y, 0, originX, originY);
            const pX = project3D(x, 0, 0, originX, originY);
            const pY = project3D(0, y, 0, originX, originY);
            const pZ = project3D(0, 0, z, originX, originY);
            const pFinal = project3D(x, y, z, originX, originY);

            // Dashed Projection Lines
            ctx3D.strokeStyle = "rgba(255, 255, 255, 0.4)";
            ctx3D.lineWidth = 1.5;
            ctx3D.setLineDash([4, 4]);

            // Floor box (X, Y projection)
            ctx3D.beginPath(); ctx3D.moveTo(pX.x, pX.y); ctx3D.lineTo(pXY.x, pXY.y); ctx3D.stroke();
            ctx3D.beginPath(); ctx3D.moveTo(pY.x, pY.y); ctx3D.lineTo(pXY.x, pXY.y); ctx3D.stroke();

            // Height line to point P
            ctx3D.strokeStyle = "#a855f7";
            ctx3D.beginPath(); ctx3D.moveTo(pXY.x, pXY.y); ctx3D.lineTo(pFinal.x, pFinal.y); ctx3D.stroke();

            ctx3D.setLineDash([]); // Reset dash

            // Draw Drone at P(x,y,z)
            ctx3D.fillStyle = "#c084fc";
            ctx3D.beginPath();
            ctx3D.arc(pFinal.x, pFinal.y, 8, 0, Math.PI * 2);
            ctx3D.fill();

            // Drone Rotors visual
            ctx3D.strokeStyle = "#e9d5ff"; ctx3D.lineWidth = 2;
            const t = Date.now() * 0.02;
            ctx3D.beginPath();
            ctx3D.moveTo(pFinal.x - 12 * Math.cos(t), pFinal.y - 12 * Math.sin(t));
            ctx3D.lineTo(pFinal.x + 12 * Math.cos(t), pFinal.y + 12 * Math.sin(t));
            ctx3D.stroke();

            // Label at Drone
            ctx3D.fillStyle = "#ffffff";
            ctx3D.font = "bold 13px sans-serif";
            ctx3D.fillText(`P(${x}, ${y}, ${z})`, pFinal.x + 12, pFinal.y - 5);
        }

        [sliderX, sliderY, sliderZ].forEach(s => s.addEventListener('input', draw3DSimulation));
        setInterval(draw3DSimulation, 30);


        // ==========================================
        // SIMULYATSIYA 3: Vaqt O'qi Canvas
        // ==========================================
        const canvasTime = document.getElementById('canvasTime');
        const ctxTime = canvasTime.getContext('2d');
        const sliderTime = document.getElementById('sliderTime');
        const btnPlayTime = document.getElementById('btnPlayTime');
        const btnResetTime = document.getElementById('btnResetTime');
        const timeWarning = document.getElementById('timeWarning');
        const timeValText = document.getElementById('timeValText');

        let isPlayingTime = false;
        let lastTimeVal = 0;

        function resizeCanvasTime() {
            canvasTime.width = canvasTime.parentElement.clientWidth;
            canvasTime.height = canvasTime.parentElement.clientHeight;
        }
        window.addEventListener('resize', resizeCanvasTime);
        resizeCanvasTime();

        function drawTimeSimulation() {
            const t = parseFloat(sliderTime.value); // 0 to 10
            timeValText.innerText = `t = ${t.toFixed(1)} s`;

            const w = canvasTime.width;
            const h = canvasTime.height;
            const startX = 60;
            const endX = w - 60;
            const axisY = h * 0.65;

            ctxTime.clearRect(0, 0, w, h);

            // 1. Draw TIME AXIS (1D arrow)
            ctxTime.strokeStyle = "#c084fc";
            ctxTime.lineWidth = 4;
            ctxTime.beginPath();
            ctxTime.moveTo(startX, axisY);
            ctxTime.lineTo(endX, axisY);
            ctxTime.stroke();

            // Arrow head
            ctxTime.fillStyle = "#c084fc";
            ctxTime.beginPath();
            ctxTime.moveTo(endX + 10, axisY);
            ctxTime.lineTo(endX - 5, axisY - 8);
            ctxTime.lineTo(endX - 5, axisY + 8);
            ctxTime.fill();

            // Axis Label
            ctxTime.font = "bold 14px sans-serif";
            ctxTime.fillText("t (vaqt, sekund)", endX - 80, axisY + 30);

            // Ticks t0, t1, t2
            const ticks = [
                { val: 0, label: "t₀ = 0s (Start)" },
                { val: 3, label: "t₁ = 3s" },
                { val: 6, label: "t₂ = 6s" },
                { val: 9, label: "t₃ = 9s" }
            ];

            ticks.forEach(tick => {
                const tx = startX + (tick.val / 10) * (endX - startX);
                ctxTime.strokeStyle = "#a855f7";
                ctxTime.lineWidth = 2;
                ctxTime.beginPath();
                ctxTime.moveTo(tx, axisY - 8);
                ctxTime.lineTo(tx, axisY + 8);
                ctxTime.stroke();

                ctxTime.fillStyle = "#94a3b8";
                ctxTime.font = "11px sans-serif";
                ctxTime.textAlign = "center";
                ctxTime.fillText(tick.label, tx, axisY + 22);
            });

            // 2. Moving Object (Car) along time and space
            const carX = startX + (t / 10) * (endX - startX);
            const carY = axisY - 35;

            // Car Body
            ctxTime.fillStyle = "#38bdf8";
            ctxTime.fillRect(carX - 20, carY - 15, 40, 20);
            ctxTime.fillStyle = "#0284c7";
            ctxTime.fillRect(carX - 10, carY - 25, 20, 10);

            // Wheels
            ctxTime.fillStyle = "#f8fafc";
            ctxTime.beginPath();
            ctxTime.arc(carX - 12, carY + 5, 5, 0, Math.PI * 2);
            ctxTime.arc(carX + 12, carY + 5, 5, 0, Math.PI * 2);
            ctxTime.fill();

            // Vertical line down to time axis
            ctxTime.strokeStyle = "#38bdf8";
            ctxTime.lineWidth = 1.5;
            ctxTime.setLineDash([3, 3]);
            ctxTime.beginPath();
            ctxTime.moveTo(carX, carY + 10);
            ctxTime.lineTo(carX, axisY);
            ctxTime.stroke();
            ctxTime.setLineDash([]);

            // Check if user manually dragged slider backwards!
            if (t < lastTimeVal - 0.2 && !isPlayingTime) {
                timeWarning.classList.remove('hidden');
                setTimeout(() => {
                    timeWarning.classList.add('hidden');
                }, 2200);
            }
            lastTimeVal = t;
        }

        // Animation Loop
        function animateTime() {
            if (isPlayingTime) {
                let cur = parseFloat(sliderTime.value);
                cur += 0.03;
                if (cur > 10) {
                    cur = 10;
                    isPlayingTime = false;
                    btnPlayTime.innerHTML = '<i class="fa-solid fa-play"></i> Vaqtni Yurgizish';
                }
                sliderTime.value = cur;
                drawTimeSimulation();
                requestAnimationFrame(animateTime);
            }
        }

        btnPlayTime.addEventListener('click', () => {
            isPlayingTime = !isPlayingTime;
            if (isPlayingTime) {
                if (parseFloat(sliderTime.value) >= 10) sliderTime.value = 0;
                btnPlayTime.innerHTML = '<i class="fa-solid fa-pause"></i> To\'xtatish';
                animateTime();
            } else {
                btnPlayTime.innerHTML = '<i class="fa-solid fa-play"></i> Vaqtni Yurgizish';
            }
        });

        btnResetTime.addEventListener('click', () => {
            isPlayingTime = false;
            sliderTime.value = 0;
            btnPlayTime.innerHTML = '<i class="fa-solid fa-play"></i> Vaqtni Yurgizish';
            drawTimeSimulation();
        });

        sliderTime.addEventListener('input', drawTimeSimulation);
        drawTimeSimulation();
    </script>
</body>
