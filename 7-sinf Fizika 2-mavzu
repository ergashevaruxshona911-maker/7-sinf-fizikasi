<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>7-sinf Fizika: Fazo va vaqt (Interaktiv Web-Dars)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- MathJax for Formula rendering -->
    <script src="https://polyfill.io/v3/polyfill.min.js?features=es6"></script>
    <script id="mathjax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0b0f19;
            color: #f1f5f9;
        }
        .glass-card {
            background: rgba(17, 24, 39, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .gradient-text {
            background: linear-gradient(135deg, #38bdf8 0%, #818cf8 50%, #c084fc 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .accent-border {
            border-left: 4px solid #38bdf8;
        }
        canvas {
            display: block;
            touch-action: none;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }
    </style>
</head>
<body class="min-h-screen pb-16">

    <!-- Header / Hero Section -->
    <header class="relative overflow-hidden bg-slate-900/90 border-b border-slate-800 sticky top-0 z-50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-sky-500/20">
                        <i class="fa-solid fa-atom animate-spin-slow"></i>
                    </div>
                    <div>
                        <span class="text-xs font-semibold text-sky-400 uppercase tracking-widest">7-sinf Fizika • Metodik Ishlanma</span>
                        <h1 class="text-xl sm:text-2xl font-black text-white">2-mavzu: <span class="gradient-text">Fazo va vaqt</span></h1>
                    </div>
                </div>
                <nav class="flex flex-wrap gap-2 text-xs sm:text-sm">
                    <a href="#reja1" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-sky-600/30 hover:text-sky-300 text-slate-300 font-medium transition border border-slate-700">1. Fazoning Cheksizligi</a>
                    <a href="#reja2" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-indigo-600/30 hover:text-indigo-300 text-slate-300 font-medium transition border border-slate-700">2. 3D Koordinatolar</a>
                    <a href="#reja3" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-purple-600/30 hover:text-purple-300 text-slate-300 font-medium transition border border-slate-700">3. Vaqt O'qi</a>
                    <a href="#testlar" class="px-3 py-1.5 rounded-lg bg-emerald-600/20 text-emerald-400 hover:bg-emerald-600/30 font-semibold transition border border-emerald-500/30"><i class="fa-solid fa-vial mr-1"></i> Interaktiv Test</a>
                </nav>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 mt-8">

        <!-- REJA 1 SECTION -->
        <section id="reja1" class="glass-card rounded-2xl p-6 sm:p-8 space-y-8 shadow-2xl">
            <div class="flex items-center gap-4 border-b border-slate-800 pb-4">
                <span class="w-12 h-12 rounded-2xl bg-sky-500/20 text-sky-400 border border-sky-500/30 flex items-center justify-center font-bold text-xl shadow-inner">1</span>
                <div>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Fazoning cheksizligi va miqyosi</h2>
                    <p class="text-xs sm:text-sm text-slate-400">Micro-olamdan Cheksiz Koinotgacha bo'lgan fazoviy masofalar va cheksizlik tushunchasi</p>
                </div>
            </div>

            <!-- Interaktiv Simulyatsiya 1 Canvas -->
            <div class="bg-slate-900 rounded-xl p-4 border border-slate-800 space-y-4">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-slate-800 pb-3">
                    <div class="flex items-center gap-2 text-sky-400 font-semibold text-sm">
                        <i class="fa-solid fa-sliders"></i> INTERAKTIV SIMULYATSIYA: Fazo Miqyosi va Zoom (Scale)
                    </div>
                    <div class="text-xs text-slate-400 bg-slate-800 px-3 py-1 rounded-full border border-slate-700">
                        Obyekt: <span id="scale-label" class="text-sky-300 font-bold">1. O'quvchi (1 metr)</span>
                    </div>
                </div>

                <div class="relative w-full h-80 sm:h-96 rounded-lg overflow-hidden bg-black border border-slate-800 flex items-center justify-center">
                    <canvas id="canvasScale" class="w-full h-full"></canvas>
                    <div class="absolute bottom-3 left-3 bg-slate-900/80 backdrop-blur px-3 py-1.5 rounded text-xs text-slate-300 border border-slate-700">
                        Kattalashtirish darajasi: <span id="scaleValText" class="text-sky-400 font-mono font-bold">1x</span>
                    </div>
                </div>

                <!-- Controls -->
                <div class="space-y-2">
                    <div class="flex justify-between text-xs text-slate-400 font-medium">
                        <span><i class="fa-solid fa-user"></i> O'quvchi (1m)</span>
                        <span><i class="fa-solid fa-school"></i> Maktab</span>
                        <span><i class="fa-solid fa-globe"></i> Yer</span>
                        <span><i class="fa-solid fa-sun"></i> Quyosh</span>
                        <span><i class="fa-solid fa-certificate"></i> Galaktika ($\infty$)</span>
                    </div>
                    <input type="range" id="scaleSlider" min="0" max="100" value="0" step="0.1" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-sky-400">
                </div>
            </div>

            <!-- Metodik Nazariya va Amaliyot -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Nazariya -->
                <div class="space-y-4">
                    <h3 class="text-lg font-bold text-sky-400 flex items-center gap-2">
                        <i class="fa-solid fa-book-open"></i> Nazariy tushuntirish
                    </h3>
                    <p class="text-slate-300 text-sm leading-relaxed">
                        Assalomu alaykum, bo‘lajak kashfiyotchilar! Tasavvur qiling, qo‘lingizda ultra-kuchli kamera bor. Bu kamera obyektivini orqaga tortib (zoom out) borgan sari fazoning yangidan-yangi chegaralari ochilaveradi:
                    </p>
                    <ul class="list-disc list-inside text-xs sm:text-sm text-slate-300 space-y-2 pl-2">
                        <li><strong class="text-white">1-bosqich:</strong> Partada o‘tirgan o‘zingiz ($1\,\text{m}$).</li>
                        <li><strong class="text-white">2-bosqich:</strong> Maktab va jonajon shahringiz ($100\,\text{m} - 10\,\text{km}$).</li>
                        <li><strong class="text-white">3-bosqich:</strong> Moviy Yer sayyorasi va Oylar ($12,700\,\text{km}$).</li>
                        <li><strong class="text-white">4-bosqich:</strong> Quyosh tizimi va yulduzlararo fazo ($1.5 \times 10^8\,\text{km}$).</li>
                        <li><strong class="text-white">5-bosqich:</strong> Sut yo‘li galaktikasi va Cheksiz Koinot!</li>
                    </ul>
                    <div class="p-3.5 rounded-xl bg-sky-950/40 border border-sky-800/50 text-sky-200 text-xs sm:text-sm accent-border">
                        <strong>Xulosa:</strong> Fazo — bu barcha moddiy jismlar joylashadigan va harakatlanadigan chegarasiz, cheksiz "sahna"dir. Qanchalik uzoqqa bormaylik, fazo cheksiz davom etadi.
                    </div>
                </div>

                <!-- Amaliy tajriba & PhET -->
                <div class="space-y-4">
                    <div class="bg-slate-800/60 p-4 rounded-xl border border-slate-700/60">
                        <h4 class="font-bold text-emerald-400 text-sm sm:text-base flex items-center gap-2 mb-2">
                            <i class="fa-solid fa-flask"></i> Sinfdagi amaliy tajriba ("Matryoshka / Quticha")
                        </h4>
                        <p class="text-xs sm:text-sm text-slate-300">
                            <strong>Utkazish tartibi:</strong> O'qituvchi 4-5 xil o'lchamdagi qutilarni namoyish etadi. Kichik quti kattasining ichida joylashadi. O'quvchilardan "Biz qayerdamiz?", "Sinf qayerda?", "Yer qayerda?" deb so'raladi va Koinotgacha bo'lgan fazoviy iyerarxiya tushuntiriladi.
                        </p>
                    </div>

                    <div class="bg-slate-800/60 p-4 rounded-xl border border-slate-700/60">
                        <h4 class="font-bold text-purple-400 text-sm sm:text-base flex items-center gap-2 mb-2">
                            <i class="fa-solid fa-laptop-code"></i> PhET Simulyatsiyasi yo'riqnomasi
                        </h4>
                        <p class="text-xs sm:text-sm text-slate-300">
                            <strong>Simulyatsiya nomi:</strong> <span class="text-purple-300 font-semibold">"Gravity and Orbits"</span><br>
                            <strong>Topshiriq:</strong> PhET platformasidan Quyosh, Yer va Oy o'rtasidagi fazoviy masofani va orbitani o'rganing. Jismlar orasidagi ulkan bo'sh fazoni kuzating.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Vizual Kadrlar & Mantiqiy Savollar -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 pt-2">
                <div class="bg-slate-900/90 p-4 rounded-xl border border-slate-800 space-y-3">
                    <h4 class="font-bold text-amber-400 text-sm flex items-center gap-2">
                        <i class="fa-solid fa-film"></i> PPT / Video uchun Kadrlar Ssenariysi
                    </h4>
                    <div class="space-y-2 text-xs text-slate-300">
                        <div class="p-2 bg-slate-800/80 rounded border border-slate-700"><strong class="text-amber-300">Kadr 1:</strong> Partada o'tirgan 7-sinf o'quvchisi 3D modelda ko'rinadi.</div>
                        <div class="p-2 bg-slate-800/80 rounded border border-slate-700"><strong class="text-amber-300">Kadr 2:</strong> Kamera birdan uzoqlashadi: Maktab, Respublika va Yer sharining fon ko'rinishi.</div>
                        <div class="p-2 bg-slate-800/80 rounded border border-slate-700"><strong class="text-amber-300">Kadr 3:</strong> Quyosh tizimi va Milky Way (Sut yo'li) galaktikasi aylanadi.</div>
                        <div class="p-2 bg-slate-800/80 rounded border border-slate-700"><strong class="text-amber-300">Kadr 4:</strong> Markazda cheksizlik belgisi ($\infty$) va *"Fazo — chegarasiz va cheksizdir"* deb yoziladi.</div>
                    </div>
                </div>

                <div class="bg-slate-900/90 p-4 rounded-xl border border-slate-800 space-y-3">
                    <h4 class="font-bold text-rose-400 text-sm flex items-center gap-2">
                        <i class="fa-solid fa-circle-question"></i> Mustahkamlash uchun Mantiqiy Savollar
                    </h4>
                    <ul class="space-y-3 text-xs sm:text-sm text-slate-300">
                        <li class="p-3 bg-slate-800/50 rounded-lg border border-slate-700/50">
                            <strong>1-savol:</strong> Agar kosmik kemada doim to'g'ri chiziq bo'ylab cheksiz ucha olsak, Koinotning so'nggi devoriga urilishimiz mumkinmi? Nima uchun?
                        </li>
                        <li class="p-3 bg-slate-800/50 rounded-lg border border-slate-700/50">
                            <strong>2-savol:</strong> Nima uchun biror jismning fazodagi o'rnini aytganda, albatta boshqa bir jismga (sanoq jismiga) nisbatan hisoblaymiz?
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- REJA 2 SECTION -->
        <section id="reja2" class="glass-card rounded-2xl p-6 sm:p-8 space-y-8 shadow-2xl">
            <div class="flex items-center gap-4 border-b border-slate-800 pb-4">
                <span class="w-12 h-12 rounded-2xl bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 flex items-center justify-center font-bold text-xl shadow-inner">2</span>
                <div>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Fazoning 3D koordinatalar sistemasida tasvirlanishi</h2>
                    <p class="text-xs sm:text-sm text-slate-400">Jismning fazodagi o'rnini aniqlash uchun uchta ($X, Y, Z$) o'q va koordinatalar sistemasi</p>
                </div>
            </div>

            <!-- Interaktiv Simulyatsiya 2 Canvas -->
            <div class="bg-slate-900 rounded-xl p-4 border border-slate-800 space-y-4">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-slate-800 pb-3">
                    <div class="flex items-center gap-2 text-indigo-400 font-semibold text-sm">
                        <i class="fa-solid fa-cube"></i> INTERAKTIV SIMULYATSIYA: Fazodagi Dron va 3D Koordinatalar
                    </div>
                    <div class="text-xs text-slate-300 bg-slate-800 px-3 py-1 rounded-full border border-slate-700">
                        Dron Koordinatasi: <span id="coord3DText" class="text-indigo-400 font-mono font-bold">P(X: 3, Y: 4, Z: 5)</span>
                    </div>
                </div>

                <div class="relative w-full h-80 sm:h-96 rounded-lg overflow-hidden bg-black border border-slate-800 flex items-center justify-center">
                    <canvas id="canvas3D" class="w-full h-full"></canvas>
                    <div class="absolute top-3 left-3 text-xs bg-slate-900/80 p-2 rounded border border-slate-700 text-slate-300">
                        <span class="text-red-400 font-bold">■ X (Uzunlik)</span> |
                        <span class="text-green-400 font-bold">■ Y (Kenglik)</span> |
                        <span class="text-blue-400 font-bold">■ Z (Balandlik)</span>
                    </div>
                </div>

                <!-- Sliders for X, Y, Z -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="space-y-1">
                        <div class="flex justify-between text-xs font-semibold text-red-400">
                            <span>X (Uzunlik)</span>
                            <span id="valX">3 m</span>
                        </div>
                        <input type="range" id="sliderX" min="0" max="8" value="3" step="0.2" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-red-500">
                    </div>
                    <div class="space-y-1">
                        <div class="flex justify-between text-xs font-semibold text-green-400">
                            <span>Y (Kenglik)</span>
                            <span id="valY">4 m</span>
                        </div>
                        <input type="range" id="sliderY" min="0" max="8" value="4" step="0.2" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-green-500">
                    </div>
                    <div class="space-y-1">
                        <div class="flex justify-between text-xs font-semibold text-blue-400">
                            <span>Z (Balandlik)</span>
                            <span id="valZ">5 m</span>
                        </div>
                        <input type="range" id="sliderZ" min="0" max="8" value="5" step="0.2" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-blue-500">
                    </div>
                </div>
            </div>

            <!-- Metodik Nazariya va Amaliyot -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Nazariya -->
                <div class="space-y-4">
                    <h3 class="text-lg font-bold text-indigo-400 flex items-center gap-2">
                        <i class="fa-solid fa-book-open"></i> Nazariy tushuntirish
                    </h3>
                    <p class="text-slate-300 text-sm leading-relaxed">
                        Biz yashayotgan fazo <strong class="text-white">uch o‘lchamli (3D)</strong>. Har qanday jismning (pashsha, samolyot yoki dron) fazodagi o‘rnini bir qiymatli ko‘rsatish uchun $O$ sanoq boshidan chiquvchi o‘zaro perpendikulyar 3 ta o‘q kerak:
                    </p>
                    <div class="p-4 rounded-xl bg-slate-800/80 text-xs sm:text-sm text-slate-300 space-y-2 border border-slate-700">
                        <p><strong class="text-indigo-300">Hayotiy analogiya (Sinf xonasidagi do'stingiz):</strong></p>
                        <ul class="list-disc list-inside space-y-1 pl-2 text-slate-300">
                            <li><strong class="text-red-400">X (Uzunlik):</strong> Kirish eshigidan sinf tubiga qarab qancha masofa?</li>
                            <li><strong class="text-green-400">Y (Kenglik):</strong> Chap devordan o'ng devorgacha qancha masofa?</li>
                            <li><strong class="text-blue-400">Z (Balandlik):</strong> Pol sathidan necha metr balandda?</li>
                        </ul>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-400">
                        Natijada jismning o‘rni $P(x, y, z)$ tartiblangan uchlik shaklida aniq ko‘rsatiladi.
                    </p>
                </div>

                <!-- Amaliy tajriba & PhET -->
                <div class="space-y-4">
                    <div class="bg-slate-800/60 p-4 rounded-xl border border-slate-700/60">
                        <h4 class="font-bold text-emerald-400 text-sm sm:text-base flex items-center gap-2 mb-2">
                            <i class="fa-solid fa-flask"></i> Sinfdagi amaliy tajriba ("Sinf burchagi va Kapalak")
                        </h4>
                        <p class="text-xs sm:text-sm text-slate-300">
                            Sinf xonasining pol burchagini $O(0,0,0)$ deb olamiz. Ikki devor bo'ylab chiziqlar $X$ va $Y$ o'qlar, vertikal burchak chizig'i esa $Z$ o'q bo'ladi. Havoda ipga osilgan koptokcha koordinatalari chizg‘ich bilan o‘lchab ko‘rsatiladi.
                        </p>
                    </div>

                    <div class="bg-slate-800/60 p-4 rounded-xl border border-slate-700/60">
                        <h4 class="font-bold text-purple-400 text-sm sm:text-base flex items-center gap-2 mb-2">
                            <i class="fa-solid fa-laptop-code"></i> PhET Simulyatsiyasi yo'riqnomasi
                        </h4>
                        <p class="text-xs sm:text-sm text-slate-300">
                            <strong>Simulyatsiya nomi:</strong> <span class="text-purple-300 font-semibold">"Vector Addition" (3D bo'limi)</span><br>
                            <strong>Topshiriq:</strong> Vektor uchini 3D fazoda harakatlantirib, $R_x, R_y, R_z$ tashkilovchilarining o'zgarishini kuzating.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Vizual Kadrlar & Mantiqiy Savollar -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 pt-2">
                <div class="bg-slate-900/90 p-4 rounded-xl border border-slate-800 space-y-3">
                    <h4 class="font-bold text-amber-400 text-sm flex items-center gap-2">
                        <i class="fa-solid fa-film"></i> PPT / Video uchun Kadrlar Ssenariysi
                    </h4>
                    <div class="space-y-2 text-xs text-slate-300">
                        <div class="p-2 bg-slate-800/80 rounded border border-slate-700"><strong class="text-amber-300">Kadr 1:</strong> Bo'sh 3D xona va burchakda $O(0,0,0)$ nuqta paydo bo'ladi.</div>
                        <div class="p-2 bg-slate-800/80 rounded border border-slate-700"><strong class="text-amber-300">Kadr 2:</strong> Qizil ($X$), Yashil ($Y$) va Ko'k ($Z$) o'qlari uzayib chiqadi.</div>
                        <div class="p-2 bg-slate-800/80 rounded border border-slate-700"><strong class="text-amber-300">Kadr 3:</strong> Xonada uchib yurgan dron to'xtaydi.</div>
                        <div class="p-2 bg-slate-800/80 rounded border border-slate-700"><strong class="text-amber-300">Kadr 4:</strong> Drondan o'qlarga tushgan punktirlar va $P(3, 4, 5)$ yozuvi porlaydi.</div>
                    </div>
                </div>

                <div class="bg-slate-900/90 p-4 rounded-xl border border-slate-800 space-y-3">
                    <h4 class="font-bold text-rose-400 text-sm flex items-center gap-2">
                        <i class="fa-solid fa-circle-question"></i> Mustahkamlash uchun Mantiqiy Savollar
                    </h4>
                    <ul class="space-y-3 text-xs sm:text-sm text-slate-300">
                        <li class="p-3 bg-slate-800/50 rounded-lg border border-slate-700/50">
                            <strong>1-savol:</strong> Doskadagi chizilgan daryo xaritasi va sinfdagi akvarium o'rtasida o'lcham (koordinata o'qlari) nuqtai nazaridan qanday farq bor?
                        </li>
                        <li class="p-3 bg-slate-800/50 rounded-lg border border-slate-700/50">
                            <strong>2-savol:</strong> Kompyuter monitoridagi 3D o'yin personaji vizual hajmli ko'rinsa-da, nima uchun u fizik jihatdan 2D ekran ichida hisoblanadi?
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- REJA 3 SECTION -->
        <section id="reja3" class="glass-card rounded-2xl p-6 sm:p-8 space-y-8 shadow-2xl">
            <div class="flex items-center gap-4 border-b border-slate-800 pb-4">
                <span class="w-12 h-12 rounded-2xl bg-purple-500/20 text-purple-400 border border-purple-500/30 flex items-center justify-center font-bold text-xl shadow-inner">3</span>
                <div>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Vaqtning bir o‘lchamli koordinatada tasvirlanishi</h2>
                    <p class="text-xs sm:text-sm text-slate-400">Vaqtning bir tomonlama yo'nalganligi (vaqt o'qi) va hodisalarning ketma-ketligi</p>
                </div>
            </div>

            <!-- Interaktiv Simulyatsiya 3 Canvas -->
            <div class="bg-slate-900 rounded-xl p-4 border border-slate-800 space-y-4">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-slate-800 pb-3">
                    <div class="flex items-center gap-2 text-purple-400 font-semibold text-sm">
                        <i class="fa-solid fa-clock"></i> INTERAKTIV SIMULYATSIYA: Vaqt O'qi va Harakat
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="text-xs text-slate-300 bg-slate-800 px-3 py-1 rounded-full border border-slate-700">
                            Vaqt: <span id="timeValText" class="text-purple-400 font-mono font-bold">t = 0.0 s</span>
                        </span>
                    </div>
                </div>

                <div class="relative w-full h-64 sm:h-72 rounded-lg overflow-hidden bg-black border border-slate-800 flex items-center justify-center">
                    <canvas id="canvasTime" class="w-full h-full"></canvas>

                    <!-- Alert overlay if user tries to reverse time -->
